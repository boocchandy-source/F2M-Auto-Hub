# Copy this file to .env for local development.
# On Render, add these values in the service's Environment tab instead.

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Administrator login. Change the password before going live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional: use a Werkzeug password hash instead of a plain password.
# Generate one with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
# ADMIN_PASSWORD_HASH=

# Optional PostgreSQL URL. Leave unset to use SQLite locally.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Folder used for the SQLite database when DATABASE_URL is not set.
# Leave unset locally to use the "instance" folder.
# DATA_DIR=/var/data

# Application timezone used for timestamps and "today".
APP_TIMEZONE=Asia/Manila

# Set to 1 on HTTPS (Render). Set to 0 for local HTTP.
SESSION_COOKIE_SECURE=0

# Trust X-Forwarded-* headers from a reverse proxy. Render sets this
# automatically; the Blueprints also set it explicitly.
# TRUST_PROXY_HEADERS=1

# Seed the company Daily Customer Record and demo records on first run.
SEED_DATA=1
SEED_DEMO_DATA=1

# Optional path to the private customer records JSON. The default is
# f2m/data/customer_records.json. On Render, point this at a mounted Secret
# File, for example /etc/secrets/customer_records.json.
# SEED_DATA_FILE=f2m/data/customer_records.json
